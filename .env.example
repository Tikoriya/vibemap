# Copy this file to .env and fill in the values.
#
# Everything prefixed EXPO_PUBLIC_ is inlined into the app bundle at build time
# and is readable from a released binary. Only put keys here that are safe to
# expose, and restrict them at the provider:
#   - Supabase publishable key: safe only while RLS is enabled on every table
#   - Google key: restrict to the Places API and the iOS/Android app IDs
#
# Supabase → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# Google Cloud Console → APIs & Services → Credentials (Places API only)
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=

# https://unsplash.com/developers → your app → Access Key
EXPO_PUBLIC_UNSPLASH_ACCESS_KEY=

# Optional — powers the "DEV — Quick login" button, which only renders in dev
# builds. Use a throwaway test account, never a personal one.
EXPO_PUBLIC_DEV_EMAIL=
EXPO_PUBLIC_DEV_PASSWORD=

# Only needed for `eas submit` (see docs/RELEASE.md). Not read by the app.
EXPO_APPLE_ID=
